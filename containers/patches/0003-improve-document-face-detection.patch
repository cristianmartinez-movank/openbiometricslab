+def _face_detection_image(image: np.ndarray) -> np.ndarray:
+    """Upscale small document photo regions before face detection."""
+    height, width = image.shape[:2]
+    scale = min(2.5, max(1.0, 640.0 / max(height, width)))
+    if scale == 1.0:
+        return image
+    return cv2.resize(
+        image,
+        None,
+        fx=scale,
+        fy=scale,
+        interpolation=cv2.INTER_CUBIC,
+    )
+
